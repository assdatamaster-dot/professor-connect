{
  "name": "@professor-connect/api",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src tests --max-warnings=0",
    "pretest": "npm run build --workspace=@professor-connect/websocket && npm run build --workspace=@professor-connect/admin-web",
    "predev": "npm run backend:prepare --prefix ../../.. && npm run build --workspace=@professor-connect/protocol --workspace=@professor-connect/services --workspace=@professor-connect/config --workspace=@professor-connect/websocket",
    "prestart": "npm run backend:prepare --prefix ../../..",
    "preview:admin": "npm run build-admin --prefix ../../.. && tsx tests/admin-preview.ts",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@professor-connect/config": "0.1.0",
    "@professor-connect/database": "0.1.0",
    "@professor-connect/websocket": "0.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "tsx": "4.23.1"
  }
}
