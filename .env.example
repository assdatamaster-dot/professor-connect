# Backend
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
REQUEST_TIMEOUT_MS=60000
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=90000
RECONNECT_WINDOW_MS=90000
CORS_ORIGINS=
TRUST_PROXY=false
UPDATE_ARTIFACTS_PATH=/app/release-updates
UPDATE_ARTIFACTS_HOST_PATH=./release-updates

# Authentication (generate independent random secrets with at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ISSUER=professor-connect
JWT_AUDIENCE=professor-connect-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# Docker Compose production publishing
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3000
PROFESSOR_CONNECT_IMAGE=professor-connect-backend:0.1.0

# WebRTC client configuration. TURN is recommended across restrictive NATs.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_ENABLED=false
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# PostgreSQL / Prisma
POSTGRES_DB=professor_connect
POSTGRES_USER=professor_connect
POSTGRES_PASSWORD=change-me-with-a-long-random-secret
DATABASE_URL=postgresql://professor_connect:change-me-with-a-long-random-secret@localhost:5432/professor_connect
