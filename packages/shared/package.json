{
  "name": "@professor-connect/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./electron": {
      "types": "./src/electron.ts",
      "default": "./dist/electron.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.spec.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1"
  },
  "peerDependencies": {
    "electron": ">=30"
  }
}
