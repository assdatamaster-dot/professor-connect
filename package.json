{
  "name": "professor-connect",
  "version": "0.1.3",
  "private": true,
  "description": "Monorepo do Professor Connect.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/backend/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build-all": "npm run build-student && npm run build-teacher",
    "build-admin": "npm run build --workspace=@professor-connect/admin-web",
    "build-backend": "turbo run build --filter=@professor-connect/api... --filter=@professor-connect/admin-web",
    "build-student": "npm run dist:win --workspace=@professor-connect/student-electron",
    "build-teacher": "npm run dist:win --workspace=@professor-connect/teacher-electron",
    "release:validate": "node scripts/validate-release-context.mjs",
    "release:qa": "npm run release:validate -- --mode qa && npm run prisma:validate && npm run check && npm run build-all && npm run updates:verify && npm run updates:stage && npm run updates:release:validate",
    "admin:test-preview": "npm run preview:admin --workspace=@professor-connect/api",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format:check",
    "clean": "turbo run clean",
    "communication:client": "npm run client:test --workspace=@professor-connect/websocket",
    "backend:prepare": "npm run prisma:generate && npm run backend:recover-migration && npm run prisma:status",
    "backend:recover-migration": "npm run migration:recover --workspace=@professor-connect/database",
    "dev": "npm run dev --workspace=@professor-connect/api",
    "desktop:student": "npm run dev --workspace=@professor-connect/student-electron",
    "desktop:teacher": "npm run dev --workspace=@professor-connect/teacher-electron",
    "dev:admin": "npm run dev --workspace=@professor-connect/admin-web",
    "deploy-production": "node scripts/deploy-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "postinstall": "npm run prisma:generate",
    "prisma:deploy": "npm run prisma:deploy --workspace=@professor-connect/database",
    "prisma:generate": "npm run prisma:generate --workspace=@professor-connect/database",
    "prisma:pull:print": "npm run prisma:pull:print --workspace=@professor-connect/database",
    "prisma:status": "npm run prisma:status --workspace=@professor-connect/database",
    "prisma:validate": "node scripts/validate-prisma-schema.mjs",
    "presence:client": "npm run presence:client --workspace=@professor-connect/websocket",
    "request:client": "npm run request:client --workspace=@professor-connect/websocket",
    "start": "npm run start --workspace=@professor-connect/api",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify-admin-publication": "node scripts/verify-admin-publication.mjs",
    "updates:stage": "node scripts/stage-update-artifacts.mjs",
    "updates:verify": "node scripts/stage-update-artifacts.mjs --verify-only",
    "updates:diagnose": "node scripts/diagnose-updates.mjs",
    "updates:release:validate": "node scripts/validate-windows-release.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "electron-builder": "26.15.3",
    "eslint": "10.0.0",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0"
  }
}
